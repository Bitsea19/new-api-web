# The backend's public URL.
#
# Empty (the default) means "same origin": every request stays relative and
# the browser resolves it against the page's own origin. Use this when a
# reverse proxy serves the dashboard and the API on one host.
#
# Set it to the backend's absolute URL to deploy the dashboard separately:
#
#   VITE_API_BASE_URL=https://api.example.com
#
# The value is baked into the bundle at build time. A static SPA cannot read
# its runtime environment, so changing the API address means rebuilding the
# frontend.
#
# When this is set, the requests become cross-origin, and the backend needs
# three things to answer them:
#
#   CORS_ALLOWED_ORIGINS=https://app.example.com
#   SESSION_COOKIE_SECURE=true
#   SESSION_COOKIE_SAME_SITE=none   (only across separate registrable domains)
#
VITE_API_BASE_URL=

# The version string shown in the dashboard's diagnostics.
VITE_REACT_APP_VERSION=dev

# The backend's URL used by the dev server's proxy. Only used by
# `bun run dev`; it has no effect on a production build.
VITE_REACT_APP_SERVER_URL=http://localhost:3000
