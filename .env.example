# 后端的公开地址。
#
# 空值（默认）表示"同源"：所有请求保持相对路径，由浏览器解析到页面自身的源上。
# 适用于反向代理把面板和 API 托管在同一主机上的场景。
#
# 要把面板独立部署，就把它设成后端的绝对地址：
#
#   VITE_API_BASE_URL=https://api.example.com
#
# 该值在构建期被编译进资源包。静态 SPA 无法读取运行时环境变量，所以改变 API 地址
# 就必须重新构建前端。
#
# 一旦设置了这个值，请求就变成跨域请求，后端需要三项配置才能正确响应：
#
#   CORS_ALLOWED_ORIGINS=https://app.example.com
#   SESSION_COOKIE_SECURE=true
#   SESSION_COOKIE_SAME_SITE=none   （仅在跨不同可注册域名时需要）
#
VITE_API_BASE_URL=

# 面板诊断信息中显示的版本号。
VITE_REACT_APP_VERSION=dev

# 开发服务器代理所指向的后端地址。只有 `bun run dev` 会用到，
# 对生产构建没有任何影响。
VITE_REACT_APP_SERVER_URL=http://localhost:3000
